# VibeSync API configuration.
# Copy to services/api/.env and replace every secret before deploying.
# NODE_ENV=production refuses to boot with the built-in development secrets or
# the placeholder values shown below.

NODE_ENV=development
PORT=4000

# Public origins used for CORS, invite links, and logging.
API_PUBLIC_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:4000

# MongoDB is required. Redis is optional for a single instance; configure it
# for multi-instance Socket.IO fan-out and distributed rate limiting.
MONGODB_URI=mongodb://127.0.0.1:27017/vibesync
REDIS_URL=

# Replace both secrets with high-entropy values, e.g. `openssl rand -hex 32`.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated browser origins. Native clients send no Origin header.
# Never use * in production.
CORS_ORIGINS=*
TRUST_PROXY=false

# Local disk storage for uploaded audio/video. Mount a persistent volume when
# running in Docker. Keep MEDIA_STORAGE_DIR outside the source tree if desired.
MEDIA_STORAGE_DIR=./storage/uploads
MAX_UPLOAD_MB=500

# WebRTC voice. STUN is required; TURN is strongly recommended for symmetric
# NAT and mobile carriers. TURN_SECRET enables coturn ephemeral credentials.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_SECRET=
TURN_TTL_SECONDS=3600

# Optional LiveKit token endpoint. The current mobile client uses the WebRTC
# mesh by default; tokens are available at GET /api/rtc/livekit-token.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

LOG_LEVEL=info
