# Copy to services/api/.env. Replace placeholders and use HTTPS public origins.
NODE_ENV=production
PORT=4000
API_PUBLIC_URL=https://api.example.com
PUBLIC_WEB_URL=https://vibesync.example.com
CORS_ORIGINS=https://vibesync.example.com
# Exactly one trusted reverse-proxy hop; keep the API bound to loopback/private network.
TRUST_PROXY=true
MONGODB_URI=mongodb://vibesync:REPLACE_WITH_APP_PASSWORD@mongo:27017/vibesync?replicaSet=rs0&authSource=vibesync
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379
JWT_ACCESS_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_RANDOM_HEX_CHARACTERS
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
LOG_LEVEL=info
MEDIA_STORAGE_DRIVER=local
MEDIA_STORAGE_DIR=/app/storage/uploads
MAX_UPLOAD_MB=500
# Optional comma-separated allowlist of external media/license hosts; no URL proxy scraping.
MEDIA_ALLOWED_HOSTS=
# Optional private S3-compatible storage. Keep the bucket private.
S3_REGION=us-east-1
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Optional bucket encryption header: AES256 or aws:kms (requires bucket IAM/KMS policy).
S3_SERVER_SIDE_ENCRYPTION=
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URL=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
TURN_SECRET=REPLACE_WITH_RANDOM_SECRET_MATCHING_COTURN
TURN_TTL_SECONDS=3600
# Optional LiveKit SFU; mobile SDK support must pass device validation.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
