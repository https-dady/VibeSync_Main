# VibeSync mobile build configuration.
# Copy this file to .env in apps/mobile and edit the values, then run
# `npm run configure` (also runs automatically before start/android/ios).
#
# In development, the app uses VIBESYNC_DEV_HOST (or the emulator default)
# plus the API port from src/config/index.js. Leave it empty to use:
#   Android emulator -> 10.0.2.2, iOS simulator -> localhost
# For a physical phone on the same Wi-Fi, set your computer's LAN IP, e.g. 192.168.1.20.
VIBESYNC_DEV_HOST=

# Used by release builds. Must be HTTPS in production.
VIBESYNC_API_URL=https://api.vibesync.app

# Public web origin used for room invite links.
VIBESYNC_WEB_URL=https://vibesync.app

# Deep-link scheme registered in AndroidManifest.xml and Info.plist.
VIBESYNC_APP_SCHEME=vibesync
