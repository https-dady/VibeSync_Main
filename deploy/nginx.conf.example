# Example Nginx reverse proxy for the VibeSync API.
# Replace api.vibesync.app and the certificate paths before enabling.
# Set TRUST_PROXY=true in services/api/.env when using this proxy.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Place this file in the http context. One ingress enforces an aggregate IP
# budget across its API upstreams; multiple ingresses need a shared edge policy.
limit_req_zone $binary_remote_addr zone=vibesync_api:10m rate=20r/s;

server {
    listen 80;
    server_name api.vibesync.app;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name api.vibesync.app;

    ssl_certificate     /etc/letsencrypt/live/api.vibesync.app/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.vibesync.app/privkey.pem;

    # Must be greater than or equal to MAX_UPLOAD_MB.
    client_max_body_size 500m;
    client_body_timeout 10m;
    limit_req_status 429;

    location / {
        limit_req zone=vibesync_api burst=60 nodelay;
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Socket.IO WebSocket upgrade.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;

        # Stream large uploads instead of buffering them on disk.
        proxy_request_buffering off;
    }
}
