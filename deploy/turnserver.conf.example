# Coturn configuration for VibeSync voice rooms.
# Install coturn, copy this file to /etc/coturn/turnserver.conf, replace the
# placeholders, and open the ports below in your firewall.
#
# TURN_SECRET in services/api/.env must equal static-auth-secret below.
# The API signs short-lived credentials with this secret, so no static TURN
# password is shipped to clients.

listening-port=3478
tls-listening-port=5349
fingerprint
use-auth-secret
static-auth-secret=REPLACE_WITH_THE_SAME_SECRET_AS_TURN_SECRET
realm=vibesync

# Public address clients use to reach this server.
external-ip=REPLACE_WITH_PUBLIC_IP

# Relay port range. Open this range for UDP in the firewall.
min-port=49160
max-port=49200

# TLS (optional but recommended). Point at valid certificates.
# cert=/etc/letsencrypt/live/turn.vibesync.app/fullchain.pem
# pkey=/etc/letsencrypt/live/turn.vibesync.app/privkey.pem

no-cli
no-multicast-peers
no-loopback-peers
# Do not permit the relay to become an internal-network proxy.
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff
no-tcp-relay
stale-nonce=600
