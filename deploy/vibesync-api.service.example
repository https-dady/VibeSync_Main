# Example systemd unit for running the API on a VM without Docker.
# Adjust User, WorkingDirectory, EnvironmentFile, and ExecStart paths.

[Unit]
Description=VibeSync API
After=network-online.target mongod.service
Wants=network-online.target

[Service]
Type=simple
User=vibesync
WorkingDirectory=/opt/vibesync/services/api
EnvironmentFile=/opt/vibesync/services/api/.env
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/vibesync/services/api/storage
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
